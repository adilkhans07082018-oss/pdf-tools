generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(cuid())
  email     String?    @unique
  role      String     @default("USER") // USER or ADMIN
  createdAt DateTime   @default(now())
  documents Document[]
}

model Document {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  toolUsed     String
  originalName String
  createdAt    DateTime @default(now())
}
